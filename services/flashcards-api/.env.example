# App
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=flashcards

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth (optional — leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Redis (optional — caches Explore search results; the API runs fine
# without it, search just always hits the database).
#
# In development this may be omitted entirely: it defaults to the
# docker-compose Redis below. In PRODUCTION there is no default — leaving it
# unset disables caching explicitly and says so at startup, rather than
# silently connecting to a localhost Redis that isn't there. On Railway use
# the private-network URL of the Redis service
# (redis://default:<password>@redis.railway.internal:6379); no TLS is needed
# on the private network, and the credentials must never be committed here.
REDIS_URL=redis://localhost:56379
# Bounds how long one Redis command may delay an HTTP request before the
# caller gives up and reads PostgreSQL instead. Raise only if the Redis
# instance is genuinely far away.
REDIS_COMMAND_TIMEOUT_MS=250
REDIS_CONNECT_TIMEOUT_MS=5000

# Email (Resend) — required in production for OTP registration/password
# reset emails to send. In development, leave RESEND_API_KEY blank to skip
# sending; OTP generation still works but delivery fails with a clear error
# until a real key is set here. Get a key from https://resend.com/api-keys
# — never commit the real value.
RESEND_API_KEY=
MAIL_FROM="Flashcards <noreply@flashcar.click>"

# OTP (email verification / password reset)
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# Flashcards
# Max cards accepted per "Bulk Add" (copy/paste) request.
MAX_BULK_FLASHCARDS=500
